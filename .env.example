# ===============================================
# AI Procurement Standards Copilot Environment Variables
# ===============================================

# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (MongoDB URI)
# Note: If MongoDB is not running, the application automatically falls back to an embedded in-memory data store.
MONGODB_URI=mongodb://127.0.0.1:27017/indian_standards_db

# JWT Secret for Officer Authentication
JWT_SECRET=indian_standards_procurement_jwt_secret_key_2026

# Optional: Google Gemini API Key for Generative AI Explanations
GEMINI_API_KEY=
